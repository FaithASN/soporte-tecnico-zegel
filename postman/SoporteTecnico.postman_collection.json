{
  "info": {
    "name": "Soporte tecnico - Parcial Zegel",
    "description": "Ejecutar las 18 peticiones en orden con la API encendida. Datos ficticios. La coleccion crea y elimina su propia solicitud.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "solicitudId",
      "value": ""
    },
    {
      "key": "fechaCreacion",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Registrar solicitud",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/solicitudes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asunto\": \"Computadora sin encender\",\n  \"descripcion\": \"No responde al boton de encendido\",\n  \"cliente\": {\n    \"nombre\": \"Ana Torres\",\n    \"email\": \"ana@example.com\"\n  },\n  \"tecnico\": null,\n  \"estado\": \"PENDIENTE\",\n  \"prioridad\": \"ALTA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const s=pm.response.json(); pm.collectionVariables.set(\"solicitudId\", s.id); pm.collectionVariables.set(\"fechaCreacion\", s.fechaCreacion); }",
              "pm.test(\"Location e identidad\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/solicitudes/\"); pm.expect(pm.response.json().id).to.be.a(\"number\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar solicitudes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/solicitudes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Incluye solicitud creada\", function () { pm.expect(pm.response.json().some(s => s.id === Number(pm.collectionVariables.get(\"solicitudId\")))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/solicitudes/{{solicitudId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"ID esperado\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"solicitudId\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Actualizar y asignar tecnico",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/solicitudes/{{solicitudId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asunto\": \"Computadora sin encender\",\n  \"descripcion\": \"No responde al boton de encendido\",\n  \"cliente\": {\n    \"nombre\": \"Ana Torres\",\n    \"email\": \"ana@example.com\"\n  },\n  \"tecnico\": {\n    \"nombre\": \"Luis Perez\",\n    \"email\": \"luis@example.com\"\n  },\n  \"estado\": \"EN_PROCESO\",\n  \"prioridad\": \"ALTA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Actualiza sin cambiar identidad ni creacion\", function () { const s=pm.response.json(); pm.expect(s.id).to.eql(Number(pm.collectionVariables.get(\"solicitudId\"))); pm.expect(s.fechaCreacion).to.eql(pm.collectionVariables.get(\"fechaCreacion\")); pm.expect(s.estado).to.eql(\"EN_PROCESO\"); pm.expect(s.tecnico.nombre).to.eql(\"Luis Perez\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Filtrar por estado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/solicitudes?estado=EN_PROCESO"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Filtro correcto\", function () { const datos=pm.response.json(); pm.expect(datos.length).to.be.above(0); pm.expect(datos.every(s => s.estado === \"EN_PROCESO\")).to.eql(true); });"
            ]
          }
        }
      ]
    },
